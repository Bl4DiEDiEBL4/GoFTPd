announce.NEWDIR = "%b%c01{NEW:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{by} %c%sec_c2{%u_name}"

announce.NEWDAY = "%b%c01{NEW DAY:}%b %c01{-}%section_colored%c01{- A new day has come!} %c%sec_c5{%date} %c01{has been created along with its symlink.}"

announce.AUDIOINFO = "%b%c01{AUDIO-INFO:}%b %c14{[}%section_colored%c14{]} %c14{%relname} %c01{Get ready for some} %c%sec_c5{%genre} %c01{from} %c%sec_c5{%year} %c01{at} %c%sec_c5{%sample_rate}Hz %c01{in} %c%sec_c5{%channels} %c%sec_c5{%bitrate} %c01{(}%c%sec_c5{%bitrate_mode}%c01{).}"

announce.MEDIAINFO = "%b%c01{SAMPLE-INFO:}%b %c14{[}%section_colored%c14{]} %c14{%relname} %c01{- Video:} %c%sec_c5{%video_format} %c%sec_c5{%{width}}%c01{x}%c%sec_c5{%{height}} %c01{- Audio:} %c%sec_c5{%audio_format} %c%sec_c5{%channels} %c01{- Subs:} %c%sec_c5{%subtitle_format} %c01{- Duration:} %c%sec_c5{%duration}"
announce.CUSTOM = "%message"
announce.RELEASEGUARD = "%c04{RELEASEGUARD:} %c05{%message}"
announce.SPACEARCHIVE = "%c14{[SPACE]:} %c09{[ARCHiViNG]} %c14{::} %c14{%relname} %c14{::} %c06{[}%c14{%size_mb} MB%c06{]} %c14{to} %c07{[}%c14{%destination_label}%c07{]}"
announce.SPACEOFFSITE = "%c14{[SPACE]:} %c13{[OFFSiTE]} %c14{::} %c14{%relname} %c14{::} %c06{[}%c14{%size_mb} MB%c06{]} %c14{to} %c07{[}%c14{%destination_label}%c07{]}"
announce.SPACEDELETE = "%c14{[SPACE]:} %c04{[DELETiNG]} %c14{::} %c14{%relname} %c14{::} %c06{[}%c14{%size_mb} MB%c06{]} %c14{from} %c07{[}%c14{%destination_label}%c07{]}"
announce.ARCHIVEINFO = "%b%c01{ARCHIVE:}%b %c14{[}%c%sec_c2{%orig_section}%c14{]} %c14{%relname} %c01{->} %c11{%target_path} %c14{(}%c06{%size_mb}MB%c14{,} %c06{%incoming_free_gb}GB %c01{in} %c06{%archive_free_gb}GB %c01{arc}%c14{)}"
announce.ARCHIVEOFFSITE = "%b%c01{ARCHIVE:}%b %c14{[}%c%sec_c2{%orig_section}%c14{]} %c14{%relname} %c01{->} %c11{%target_path} %c14{(}%c06{%size_mb}MB%c14{,} %c06{offsite}%c14{)}"

announce.SPEEDTEST = "%b%c01{SPEEDTEST:}%b %c04{%nick} %c01{%action} %c01{a} %c05{%{size_mb}MB} %c01{file with} %c06{%speed_mbs}"

announce.SFV_RAR = "%b%c01{RACE:}%b %c14{[}%section_colored%c14{]} Got SFV for %c14{%subdir_prefix}%c14{%relname} %c01{uploaded by} %c%sec_c2{%u_name}%c01{. Now expecting} %b%c14{%t_filecount}%b %c01{%t_file_label.}"

announce.UPDATE_RAR = "%b%c01{RACE:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{got its first rar file from} %c%sec_c2{%u_name} %c01{at} %b%c14{%u_speed}%b%c01{. Now expecting} %b%c14{%t_mbytes}%b%c01{.}"

announce.UPDATE_RAR_UNKNOWN = "%b%c01{RACE:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{got its first rar file from} %c%sec_c2{%u_name} %c01{at} %b%c14{%u_speed}%b%c01{.}"

announce.UPDATE_ZIP = "%b%c01{RACE:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{got its first zip file from} %c%sec_c2{%u_name} %c01{at} %b%c14{%u_speed}%b%c01{. Now expecting} %b%c14{%t_files}%b %c01{file(s).}"

announce.UPDATE_ZIP_UNKNOWN = "%b%c01{RACE:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{got its first zip file from} %c%sec_c2{%u_name} %c01{at} %b%c14{%u_speed}%b%c01{.}"

announce.UPDATE_TRACK = "%b%c01{RACE:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{got first track from} %c%sec_c2{%u_name} %c01{at} %b%c14{%u_speed}%b%c01{.}"

announce.RACE_RAR = "%b%c01{RACE:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{-} %c%sec_c2{%u_name} joined the race %c01{at} %b%c14{%u_speed}%b%c01{.}"

announce.NEWLEADER = "%b%c01{NEW LEADER:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{-} %c%sec_c2{%leader_name} %c01{takes the lead -} %b%c14{%{leader_mb}MB}%b%c01{/}%b%c14{%{leader_files}F}%b%c01{/}%b%c14{%{leader_pct}%}%b%c01{/}%b%c14{%leader_speed}%b %c01{-} %b%c14{%t_filesleft}%b %c01{files left.}"

announce.HALFWAY = "%b%c01{HALFWAY:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{- avg speed:} %b%c14{%t_avgspeed}%b %c01{- time left:} %b%c14{%t_timeleft}%b %c01{- leader:} %c%sec_c2{%leader_name} %c14{[}%b%c14{%{leader_mb}MB}%b%c01{/}%b%c14{%{leader_files}F}%b%c01{/}%b%c14{%{leader_pct}%}%b%c01{/}%b%c14{%leader_speed}%b%c01{] -} %b%c14{%t_filesleft}%b %c01{files left.}"

announce.TVINFO = "%b%c01{TV-INFO:}%b %c14{[}%section_colored%c14{]} %c14{%relname} %c01{- Genre:} %c%sec_c5{%genre} %c01{- Type:} %c%sec_c5{%type} %c01{- Link:} %c%sec_c5{%link}\n%b%c01{TV-INFO:}%b %c14{[}%section_colored%c14{]} %c14{%relname} %c01{- Network:} %c%sec_c5{%network} %c01{- Rating:} %c%sec_c5{%rating} %c01{- Language:} %c%sec_c5{%language}"

announce.MOVIEINFO = "%b%c01{MOVIE-INFO:}%b %c14{[}%section_colored%c14{]} %c14{%relname} %c01{-} %c%sec_c5{%title} %c01{(}%c%sec_c5{%year}%c01{)} %c01{- Genre:} %c%sec_c5{%genre} %c01{-} %c%sec_c5{%rating}/10 %c01{(}%c%sec_c5{%votes} votes%c01{) - Metacritic:} %c%sec_c5{%metacritic} %c01{-} %c%sec_c5{%runtime} %c01{-} %c%sec_c5{%language}\n%b%c01{MOVIE-INFO:}%b %c14{[}%section_colored%c14{]} %c14{%relname} %c01{- Link:} %c%sec_c5{%link} %c01{- Director:} %c%sec_c4{%director} %c01{- Stars:} %c%sec_c4{%stars}"

announce.COMPLETE = "%b%c01{COMPLETE:}%b %c14{[}%section_colored%c14{]} %c14{%subdir_prefix}%c14{%relname} %c01{by} %b%c14{%u_count}%b %c01{racers -} %b%c14{%t_mbytes}%b%c01{/}%b%c14{%t_files}%b%c01{/}%b%c14{%t_avgspeed}%b%c01{/}%b%c14{%t_duration}%b"

announce.STATS_HOF = "%b%c01{STATS:}%b ▂▃▅▇█▓▒░۩۞۩  %c%sec_c2{Users Hall Of Fame}  ۩۞۩░▒▓█▇▅▃▂"

announce.STATS_SPEEDS = "%b%c01{STATS:}%b %c14{Slowest:} %c%sec_c2{%u_slowest_name} %c14{at} %b%c14{%u_slowest_speed}%b %c14{-} %c14{Fastest:} %c%sec_c2{%u_fastest_name} %c14{at} %b%c14{%u_fastest_speed}%b%c14{.}"

announce.STATS_USER_HEADER = "%b%c01{STATS:}%b %c14{[ }%c%sec_c2{UserTop} %c14{]}"

announce.STATS_USER = "%b%c01{STATS:}%b %c14{[}%c03{%{u_rank}}%c14{]} %c%sec_c2{%{u_name}} %c01{/} %c07{%{u_group}} %c14{-} %b%c14{%{u_files}f}%b %c14{-} %b%c14{%{u_mb}MB}%b %c14{-} %b%c14{%{u_pct}%}%b %c14{-} %b%c14{%{u_speed}}%b %c14{[ }%c14{ALLUP} %c03{#%{u_alup}} %c14{] [ }%c14{WKUP} %c03{#%{u_wkup}} %c14{]}"

announce.STATS_GROUP_HEADER = "%b%c01{STATS:}%b %c14{[ }%c%sec_c2{GroupTop} %c14{]}"

announce.STATS_GROUP = "%b%c01{STATS:}%b %c14{[}%c03{%{g_rank}}%c14{]} %c07{%{g_name}} %c14{-} %b%c14{%{g_files}f}%b %c14{-} %b%c14{%{g_mb}MB}%b %c14{-} %b%c14{%{g_pct}%}%b %c14{-} %b%c14{%{g_speed}}%b"

announce.STATS_END = "%b%c01{STATS:}%b -----------====>>>>           %c%sec_c5{END}          <<<<====-----------"

announce.BNC = "%b%c01{BNC:}%b %c01{Checking %{sitename} status, please wait ...}"

announce.BNC_UP = "%c03{%index}.- %c06{%name} %c01{at} %c05{%host}%c01{:}%c05{%port} %c01{is} %c03{UP} %c01{(login:} %c05{%latency}ms%c01{)}"

announce.BNC_DOWN = "%c04{%index}.- %c06{%name} %c01{at} %c05{%host}%c01{:}%c05{%port} %c01{is} %c04{DOWN} %c01{(%error)}"

announce.BNC_ERROR = "%b%c01{BNC:}%b %c04{%response}"

announce.LOGINFAIL = "%c02{LOGiN:} %c04{%message}"
announce.USERCHANGE = "%c02{USER:} %c05{%message}"
announce.SLAVEAUTHFAIL = "%c04{SLAVESEC:} %c07{%message}"
