# Public IRC gateway for SITE REQUEST/REQUESTS/REQFILL/REQTOP/REQDEL.
# !request stores the IRC nick as requester. !reqdel only deletes that
# nick's own requests; !reqfill stores the IRC nick as filler; !reqwipe is
# staff-only.
host: "127.0.0.1"
port: 21212
user: "weaveftpd"
password: "weaveftpd"
tls: true
insecure_skip_verify: true
timeout_seconds: 10

channels: ["#weaveftpd-chat"]
staff_channels: ["#weaveftpd-staff"]
staff_hosts: []

# reply_target supports "channel", "notice", or a fixed "#channel".
reply_target: "channel"
