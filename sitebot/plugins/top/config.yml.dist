# Daily uploader leaderboard from weaveftpd userfiles.
# IRC commands:
#   !top
#   !top 5
#   !top 10
#   !top 25
users_dir: "../etc/users"

# Uses sitebot/global timezone when set in the main config so daily cutover
# matches the server stats reset.

channels: ["#weaveftpd-chat"]

# reply_target supports "channel", "notice", "pm", or a fixed "#channel".
reply_target: "channel"

# Bounds for !top requests from IRC.
default_count: 10
max_count: 25

# Optional case-insensitive filters. Matching users/groups are removed from
# the leaderboard and from total files/size.
excluded_users: []
excluded_groups: []

# Optional periodic announce. Routed through sitebot's normal type routing as
# output type TOP, then announce.default_channel, then irc.channels.
auto_enabled: false
auto_interval_hours: 8
auto_only_nonzero: true
