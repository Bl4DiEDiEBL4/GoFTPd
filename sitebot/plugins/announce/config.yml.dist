# Fallback channel for announce types that do not have a more specific route.
default_channel: "#weaveftpd-staff"

# Shared theme file used to render formatted announce lines.
# Bundled presets:
#   ./etc/templates/pzsng.theme
#   ./etc/templates/drftpd.theme
theme_file: "./etc/templates/pzsng.theme"

# Collapse repeated LOGINFAIL announces for the same username/reason/source
# within this many seconds, so staff does not get flooded by retry storms.
loginfail_cooldown_seconds: 10

# Explicit type -> channel routes.
type_routes:
  NUKE: ["#weaveftpd-nuke"]
  AUTONUKEWARN: ["#weaveftpd-nuke"]
  AUTONUKEDELETE: ["#weaveftpd-nuke"]
  UNNUKE: ["#weaveftpd-nuke"]
  NEWDAY: ["#weaveftpd"]
  SPEEDTEST: ["#weaveftpd"]
  TOP: ["#weaveftpd-chat"]
  LOGIN: ["#weaveftpd-staff"]
  USERCHANGE: ["#weaveftpd-staff"]
  SELFIP: ["#weaveftpd-staff"]
  RELEASEGUARD: ["#weaveftpd-staff"]
  SLAVEAUTH: ["#weaveftpd-staff"]
  REMERGE: ["#weaveftpd-staff"]
  SLOWUPLOADWARN: ["#weaveftpd-staff"]
  SLOWUPLOADKICK: ["#weaveftpd-staff"]
  SLOWDOWNLOADWARN: ["#weaveftpd-staff"]
  SLOWDOWNLOADKICK: ["#weaveftpd-staff"]
  # External scripts can write CUSTOM JSON events to the sitebot FIFO and set
  # data.announce_type to one of these values for explicit routing.
  # SPACEARCHIVE: ["#weaveftpd-archive"]
  # SPACEOFFSITE: ["#weaveftpd-archive"]
  # SPACEDELETE: ["#weaveftpd-archive"]

# Pretime rendering mode:
#   newline = emit a second PRETiME line with OK/BAD
#   inline  = hold NEW briefly and replace it with a single NEW ... released ...
pretime:
  mode: "newline"
