# WeaveFTPd .gitignore

# Binary
/weaveftpd
*.exe
*.so
*.dylib
copy.sh
sitebot/sitebot
etc/weaveftpd.sitebot.fifo

# TLS certificates (generate your own with setup.sh)
etc/certs/
etc/server.crt
etc/server.key
*.pem

# User files - only keep default.user and weaveftpd as examples
etc/users/*
!etc/users/default.user
!etc/users/weaveftpd
etc/users/n0pe

# Group files - only keep NoGroup as example
etc/groups/*
!etc/groups/NoGroup

# Passwd file (contains hashes)
#etc/passwd
etc/passwd-
etc/group-
etc/permissions.yml-
etc/affils.yml-
etc/slave_denylist.txt-
etc/slave_masks.txt
etc/slave_masks.txt-
etc/users-/
etc/groups-/

# Site data (actual files on disk)
site/
/site

# Databases and logs
*.db
*.sqlite
*.sqlite3
logs/
*.log
sitebot/data/

# VFS persistence data
userdata/

# Runtime config (keep examples only)
etc/config.yml
!etc/config-master.yml
!etc/config-slave.yml
sitebot/etc/config.yml
docker/deploy/master.env
docker/deploy/slave.env
docker/deploy/runtime/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*.rej
*~
*.iml

# OS
.DS_Store
Thumbs.db

# Build / Dependencies
vendor/
*.o
*.a
.gocache/
.gomodcache/
.tmp_*.test
.tmp_drftpd/
.tmp_pzsng_source/
.tmp_drftpd3_case/
.tmp_drftpd3_import_test.py
