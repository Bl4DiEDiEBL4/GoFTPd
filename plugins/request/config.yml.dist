# TUR-style request manager:
#   SITE REQUEST Release.Name-GRP
#   SITE REQUESTS
#   SITE REQFILL <number|Release.Name-GRP>
#   SITE REQTOP [limit]
#   SITE REQDEL <number|Release.Name-GRP>
#   SITE REQWIPE <number|Release.Name-GRP>
dir: "/REQUESTS"

# Requests and REQTOP fill counters are cached in VFS metadata and mirrored to
# this JSON file. Startup hydrates VFS metadata from the file, so it is readable
# and easy to back up or manually repair.
state_file: "userdata/request_state.json"

# Optional: pin request storage to one writable slave. This keeps the request
# root metadata and REQ-/FILLED-* dirs together instead of using automatic
# upload routing. Leave empty to auto-select like normal writes.
# storage_slave: "LOCAL"

# Directory name prefixes for open vs filled requests.
request_head: "REQ-"
filled_head: "FILLED-"

# Name normalization for request dirs.
allow_space: false
replace_with: "_"
bad_chars: '*{^~/,+&\'

# Per-user request cap.
max_requests: 30

# Default number of users shown by SITE REQTOP.
reqtop_limit: 10

# When true, SITE REQUEST replies with the full current request list instead of
# a short "added" confirmation line.
show_on_request: false

# When true, SITE REQFILL/REQFILLED replies with the updated request list
# instead of a short "filled" confirmation line.
show_on_fill: false

# When false, SITE REQUEST creates REQ-<release> immediately.
# When true, only the VFS request metadata entry is created first and
# FILLED-<release> is created later at fill time.
do_not_create_dir_until_filled: false

# Staff flags required for SITE REQWIPE.
reqwipe_flags: "1"

# FTP users allowed to submit hidden -by:<irc nick> ownership on behalf of
# sitebot commands. Keep this to the dedicated sitebot/admin FTP account.
proxy_users: ["weaveftpd"]

debug: false
